{
  "name": "demipass",
  "version": "2.7.0",
  "description": "Secrets management for LLM sessions. Keep credentials out of context windows.",
  "main": "index.js",
  "bin": {
    "demipass-mcp": "./mcp-server.js",
    "fleetgate-mcp": "./fleetgate-mcp.js",
    "demipass-onboard": "./onboard.js",
    "conduit-receiver": "./bin/conduit-receiver.js"
  },
  "mcpName": "com.dustforge/demipass",
  "scripts": {
    "mcp": "node mcp-server.js",
    "buoy": "node buoy-mcp.js",
    "test": "npm run test:startup && npm run test:runtime-catalog && npm run test:session && npm run test:receiver && npm run test:listener && node --test test/public-route.test.js && node test/use-token-flow.test.js && node test/services.test.js && node test/conduit.test.js && node --test test/fleetgate-mcp.test.js test/fleetgate-admission.test.js && node --test test/onboard.test.js test/pane-autobind.test.js test/pane-launcher.test.js && npm run test:sealed",
    "test:extension": "node --test extension/test/*.test.js",
    "test:extension:e2e": "node extension/test/e2e/smoke.js",
    "test:extension:e2e:all": "node extension/test/e2e/smoke.js --browser=chromium,chrome,brave,firefox,zen",
    "build:extension": "node extension/build.mjs",
    "package:extension": "node extension/build.mjs --package",
    "fleetgate": "node fleetgate-mcp.js",
    "test:sealed": "node --test test/sealed*.test.js",
    "test:listener": "node --test test/conduit-listener.test.js test/conduit-codex-adapter.test.js",
    "test:receiver": "node --test test/conduit-receiver*.test.js",
    "test:session": "node --test test/conduit-session-context.test.js",
    "test:runtime-catalog": "node --test test/conduit-runtime-catalog.test.js",
    "test:startup": "node --test test/conduit-startup.test.js"
  },
  "keywords": [
    "secrets",
    "credentials",
    "llm",
    "ai-agents",
    "claude",
    "mcp",
    "vault",
    "context-window",
    "prompt-injection",
    "demipass",
    "dustforge",
    "buoy",
    "temporal",
    "anchor"
  ],
  "author": "AKStrapped LLC",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bildow/demipass.git"
  },
  "homepage": "https://demipass.com",
  "engines": {
    "node": ">=14.18"
  },
  "files": [
    "index.js",
    "services.js",
    "docs/services.md",
    "mcp-server.js",
    "buoy-mcp.js",
    "fleetgate-mcp.js",
    "onboard.js",
    "README.md",
    "ONBOARDING.md",
    "docs/security-stance.md",
    ".env.example",
    "http-json.js",
    "public-route.js",
    "docs/conduit.md",
    "docs/pane-launcher.md",
    "bin/demipass-pane-mcp.js",
    "bin/install-pane-launcher.sh",
    "fleetgate-admission.js",
    "sealed/",
    "docs/conduit-sealed.md",
    "docs/conduit-wave2.md",
    "docs/conduit-wave3.md",
    "docs/conduit-wave4.md",
    "docs/conduit-wave5.md",
    "docs/conduit-wave6.md",
    "docs/conduit-wave6-runtime.md",
    "docs/conduit-goose.md",
    "conduit-listener.js",
    "conduit-codex-adapter.js",
    "docs/conduit-listener.md",
    "bin/conduit-receiver.js",
    "conduit-receiver-profile.js",
    "conduit-receiver-runtime.js",
    "conduit-receiver-host.js",
    "conduit-http-adapter.js",
    "conduit-seat-server.js",
    "docs/conduit-receiver-provisioning.md",
    "conduit-session-context.js",
    "bin/conduit-session-hook.js",
    "docs/conduit-session-rebind.md",
    "conduit-runtime-catalog.js",
    "docs/conduit-runtime-onboarding.md",
    "conduit-startup.js",
    "conduit-receiver-manager.js",
    "bin/conduit-claude-start.js",
    "bin/conduit-claude-resume.js"
  ],
  "dependencies": {
    "hpke-js": "1.8.1",
    "shamir-secret-sharing": "0.0.4",
    "ws": "8.23.0"
  }
}
