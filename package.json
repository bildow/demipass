{
  "name": "demipass",
  "version": "2.6.0",
  "description": "Secrets management for LLM sessions. Keep credentials out of context windows.",
  "main": "index.js",
  "bin": {
    "demipass-mcp": "./mcp-server.js",
    "fleetgate-mcp": "./fleetgate-mcp.js",
    "demipass-onboard": "./onboard.js",
    "fleetengine-mcp": "./fleetengine-mcp.js"
  },
  "mcpName": "com.dustforge/demipass",
  "scripts": {
    "mcp": "node mcp-server.js",
    "buoy": "node buoy-mcp.js",
    "test": "node test/use-token-flow.test.js && node test/services.test.js && node test/conduit.test.js && node --test test/fleetgate-mcp.test.js && node --test test/fleetengine-mcp.test.js && node --test test/onboard.test.js",
    "test:extension": "node --test extension/test/*.test.js",
    "test:extension:e2e": "node extension/test/e2e/smoke.js",
    "test:extension:e2e:all": "node extension/test/e2e/smoke.js --browser=chromium,chrome,brave,firefox,zen",
    "build:extension": "node extension/build.mjs",
    "package:extension": "node extension/build.mjs --package",
    "fleetgate": "node fleetgate-mcp.js",
    "fleetengine": "node fleetengine-mcp.js"
  },
  "keywords": [
    "secrets",
    "credentials",
    "llm",
    "ai-agents",
    "claude",
    "mcp",
    "vault",
    "context-window",
    "prompt-injection",
    "demipass",
    "dustforge",
    "buoy",
    "temporal",
    "anchor"
  ],
  "author": "AKStrapped LLC",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bildow/demipass.git"
  },
  "homepage": "https://demipass.com",
  "engines": {
    "node": ">=14"
  },
  "files": [
    "index.js",
    "services.js",
    "docs/services.md",
    "mcp-server.js",
    "buoy-mcp.js",
    "fleetgate-mcp.js",
    "fleetengine-mcp.js",
    "onboard.js",
    "README.md",
    "ONBOARDING.md",
    "docs/security-stance.md",
    ".env.example",
    "http-json.js",
    "docs/conduit.md",
    "fleetgate-admission.js",
    "docs/fleetengine.md"
  ]
}
